  /** Get the token beginning character line number. */
  public int getBeginLine() {
#if KEEP_LINE_COLUMN
    return bufline[tokenBegin];
#else
    return -1;
#fi
  }

  /** Get the token beginning character column number. */
  public int getBeginColumn() {
#if KEEP_LINE_COLUMN
    return bufcolumn[tokenBegin];
#else
    return -1;
#fi
  }

  /** Get the token ending character line number. */
  public int getEndLine() {
#if KEEP_LINE_COLUMN
    return bufline[bufpos];
#else
    return -1;
#fi
  }

  /** Get the token ending character column number. */
  public int getEndColumn() {
#if KEEP_LINE_COLUMN
    return bufcolumn[bufpos];
#else
    return -1;
#fi
  }

#if KEEP_LINE_COLUMN
  /**
   * Adjust line and column numbers for the start of a token.
   *
   * @param newLine - the new line number.
   * @param newCol - the new column number.
   */
  public void adjustBeginLineColumn(int newLine, int newCol) {
    int start = tokenBegin;
    int len;

    if (bufpos >= tokenBegin) {
      len = bufpos - tokenBegin + inBuf + 1;
    } else {
      len = bufsize - tokenBegin + bufpos + 1 + inBuf;
    }

    // Renumber exactly the len characters of the current token, and nothing
    // else.  The previous implementation compared each character against its
    // successor in the buffer, which for a one-character token (what the
    // JJTree @egen handling adjusts) reads a character that has not been read
    // yet: its stored line is still 0, the comparison fails, and the fallback
    // branch then walks one position PAST the token, clobbers it, and finally
    // takes line/column from there -- silently undoing the adjustment.
    int idx = start % bufsize;
    int prevLine = bufline[idx];
    int prevCol = bufcolumn[idx];
    int curLine = newLine;
    int curCol = newCol;

    bufline[idx] = curLine;
    bufcolumn[idx] = curCol;

    for (int i = 1; i < len; i++) {
      idx = (start + i) % bufsize;
      int origLine = bufline[idx];
      int origCol = bufcolumn[idx];

      if (origLine != prevLine) {
        // a line break inside the token: columns restart with the original ones
        curLine++;
        curCol = origCol;
      } else {
        curCol += origCol - prevCol;
      }

      bufline[idx] = curLine;
      bufcolumn[idx] = curCol;
      prevLine = origLine;
      prevCol = origCol;
    }

    line = curLine;
    column = curCol;
  }

