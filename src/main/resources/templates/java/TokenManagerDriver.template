  /** Get the next Token. */
  public ${STATIC?static :}Token getNextToken() {
    Token specialToken = null;
    Token matchedToken;
    int lastReadPosition = 0;

    EOFLoop:
    for (;;) {
      // First see if we have any input at all.
      try {
        curChar = input_stream.BeginToken();
#if DEBUG_TOKEN_MANAGER
        if (trace_enabled()) System.err.println(
              "Read 1st char for any kind: " + disp_char(curChar) + 
#if KEEP_LINE_COLUMN
              ", @ " + input_stream.getBeginLine() + ":" + input_stream.getBeginColumn() +
#fi
              " (tm)");
#fi
#if IGNORE_CASE
        curChar = Character.toLowerCase(curChar);
#fi
      } catch (Exception e) {
#if DEBUG_TOKEN_MANAGER
        if (trace_enabled()) System.err.println(
              disp_state(curLexState, lexStateNames) +
              " Reached EOF (1st)" +
#if KEEP_LINE_COLUMN
              ", @ " + input_stream.getBeginLine() + ":" + input_stream.getBeginColumn() +
#fi
              " (tm)");
#fi
        // No input. So return EOF token.
        jjmatchedKind = EOF;
        jjmatchedPos = -1;
        matchedToken = jjFillToken();
        matchedToken.specialToken = specialToken;
        return matchedToken;
      }
#if DEBUG_TOKEN_MANAGER
      if (trace_enabled()) System.err.println(
            disp_state(curLexState, lexStateNames) +
            " Current input char: " + disp_char(curChar) +
#if KEEP_LINE_COLUMN
            ", @ " +
            input_stream.getBeginLine() + ":" + input_stream.getBeginColumn() +
#fi
            " (tm)");
#fi

      // Set matched kind to a MAX VALUE to implement largest, first occurring rule
      // i.e., smallest kind value matched should be used.
      image = jjimage;
      image.setLength(0);
      jjimageLen = 0;

      for (;;) { // inner loop
        jjmatchedKind = Integer.MAX_VALUE;
        jjmatchedPos = 0;
#if !NO_DFA
        lastReadPosition = jjRunStringLiteralMatch();
#else
        lastReadPosition = jjMoveNfa(jjInitStates[curLexState], 0);
#fi

        if (jjmatchedPos == 0 && jjmatchedKind > canMatchAnyChar[curLexState]) {
          jjmatchedKind = canMatchAnyChar[curLexState];
#if DEBUG_TOKEN_MANAGER
          if (trace_enabled()) System.err.println(
                "Matched current char: " + disp_char(curChar) +
                " as a wildcard kind: " + jjmatchedKind + " (tm)");
#fi
        }

        if (jjmatchedKind == Integer.MAX_VALUE) {
          jjmatchedKind = jjInitialMatchForLexState[curLexState];
          jjmatchedPos = -1;
#if DEBUG_TOKEN_MANAGER
          if (trace_enabled()) System.err.println(
                "Matched empty string as kind: " + jjmatchedKind + " (tm)");
#fi
        }
        if (jjmatchedKind != Integer.MAX_VALUE) {
          // We have a match!
#if DEBUG_TOKEN_MANAGER
          if (trace_enabled()) System.err.println(
                "Put back: " + (lastReadPosition - jjmatchedPos) + " looked ahead chars (tm)");
#fi
          // Put back any characters looked ahead.
          input_stream.backup(lastReadPosition - jjmatchedPos);
          
          if (isToken(jjmatchedKind)) {
            // Matched kind is a real TOKEN.
            matchedToken = jjFillToken();
            matchedToken.specialToken = specialToken;
            TokenLexicalActions(matchedToken);
            if (jjnewLexState[jjmatchedKind] != -1) {
              curLexState = jjnewLexState[jjmatchedKind];
            }
#if COMMON_TOKEN_ACTION
            CommonTokenAction(matchedToken);
#fi
#if DEBUG_TOKEN_MANAGER
            if (trace_enabled()) System.err.println(
                  "Found a TOKEN MATCH ***: <" + jjmatchedKind +
                  " / " + tokenImage[jjmatchedKind] +
                  " / \"" + add_escapes(matchedToken.image) +
                  "\"> at lexical state: " + curLexState + "; returning (tm)");
#fi
            return matchedToken;
          }
          
          if (isSkip(jjmatchedKind)) {
            // Matched kind is a SKIP.
#if DEBUG_TOKEN_MANAGER
            if (trace_enabled()) System.err.println(
                  "Found a SKIP match: <" + jjmatchedKind  +
                  "> at lexical state: " + curLexState + "; continuing (tm)");
#fi
            SkipLexicalActions(null);
            if (jjnewLexState[jjmatchedKind] != -1) {
              curLexState = jjnewLexState[jjmatchedKind];
            }
            continue EOFLoop;
          }
          
          if (isSpecial(jjmatchedKind)) {
            // Matched kind is a SPECIAL_TOKEN.
            matchedToken = jjFillToken();
#if DEBUG_TOKEN_MANAGER
            if (trace_enabled()) System.err.println(
                  "Found a SPECIAL_TOKEN match: <" + jjmatchedKind +
                  " / \"" + add_escapes(matchedToken.image) +
                  "\"> at lexical state: " + curLexState + "; continuing (tm)");
#fi
            if (specialToken == null) {
              specialToken = matchedToken;
            } else {
              matchedToken.specialToken = specialToken;
              specialToken = (specialToken.next = matchedToken);
            }
            SkipLexicalActions(matchedToken);
            if (jjnewLexState[jjmatchedKind] != -1) {
              curLexState = jjnewLexState[jjmatchedKind];
            }
            continue EOFLoop;
          }
          
          // Matched kind is a MORE.
          MoreLexicalActions();
          if (jjnewLexState[jjmatchedKind] != -1) {
            curLexState = jjnewLexState[jjmatchedKind];
          }
#if DEBUG_TOKEN_MANAGER
            if (trace_enabled()) System.err.println(
                  "Found a MORE match: <" + jjmatchedKind  +
                  "> at lexical state: " + curLexState + "; reading (tm)");
#fi
          lastReadPosition = 0;
          jjmatchedKind = Integer.MAX_VALUE;
          try {
            curChar = input_stream.readChar();
#if DEBUG_TOKEN_MANAGER
            if (trace_enabled()) System.err.println(
                  "Read next char for a MORE: " + disp_char(curChar) +
#if KEEP_LINE_COLUMN
                  ", @ " + input_stream.getBeginLine() + ":" + input_stream.getBeginColumn() +
#fi
                  " (tm)");
#fi
#if IGNORE_CASE
            curChar = (int) Character.toLowerCase((char) curChar);
#fi
            continue;
          } catch (java.io.IOException e1) {
#if DEBUG_TOKEN_MANAGER
            if (trace_enabled()) System.err.println(
                  disp_state(curLexState, lexStateNames) +
                  " Reached EOF (in a MORE)" +
#if KEEP_LINE_COLUMN
                  ", @ " +
                  input_stream.getBeginLine() + ":" + input_stream.getBeginColumn() +
#fi
                  " (tm)");
#fi
            // TODO see how to handle this case: fall to reportError or break/continue the loop
          }
        }
        // Here jjmatchedKind == Integer.MAX_VALUE or EOF in MORE
        // reportError will throw a new TokenMgrError(...)
        reportError(lastReadPosition);
      } // inner loop
    } // EOFLoop
  }

  protected ${STATIC?static :}Token jjFillToken() {
    final String curTokenImage;
#if KEEP_LINE_COLUMN
    final int beginLine;
    final int endLine;
    final int beginColumn;
    final int endColumn;
#fi
    if (jjmatchedPos < 0) {
      if (image == null) {
        curTokenImage = "";
      } else {
        curTokenImage = image.toString();
      }
#if KEEP_LINE_COLUMN
      beginLine = endLine = input_stream.getEndLine();
      beginColumn = endColumn = input_stream.getEndColumn();
#fi
    } else {
      final String im = jjstrLiteralImages[jjmatchedKind];
      curTokenImage = (im == null) ? input_stream.GetImage() : im;
#if KEEP_LINE_COLUMN
      beginLine = input_stream.getBeginLine();
      beginColumn = input_stream.getBeginColumn();
      endLine = input_stream.getEndLine();
      endColumn = input_stream.getEndColumn();
#fi
    }
#if TOKEN_FACTORY
    final Token t = ${TOKEN_FACTORY}.newToken(jjmatchedKind, curTokenImage);
#else
    final Token t = Token.newToken(jjmatchedKind, curTokenImage);
#fi
#if KEEP_LINE_COLUMN
    t.beginLine = beginLine;
    t.endLine = endLine;
    t.beginColumn = beginColumn;
    t.endColumn = endColumn;
#fi
    return t;
  }

#if !NO_DFA
  private ${STATIC?static :}int jjRunStringLiteralMatch() {
    int curPos = 0;
    int key = (int) curLexState << 16 | curChar;
    int startState = jjInitStates[curLexState];
    if (startAndSize.containsKey(key)) {
      int[] arr = startAndSize.get(key);
      int index = arr[0];
      for (int i = 0; i < arr[1]; i++) {
        int len = stringLiterals[index++];
        int ignoreCase = stringLiterals[index++];
#if DEBUG_TOKEN_MANAGER
        if (trace_enabled()) System.err.println(
              "  Looking for string literal match of token: <" + stringLiterals[index + len] +
              " / " + tokenImage[stringLiterals[index + len]] + "> (tm)");
#fi
        do {
#if DEBUG_TOKEN_MANAGER
          if (trace_enabled()) System.err.println(
                "  Cur char: " + disp_char(curChar) + " (tm)");
#fi
          if (curChar != stringLiterals[index + curPos]
              && (ignoreCase == 0 || curChar != stringLiterals[index + len + curPos])) {
            break;
          }
          if (++curPos == len) {
            break;
          }
          if (!moveToNextChar()) {
            --curPos;
            break;
          }
        } while (curPos < len);
        if (curPos == len) {
          jjmatchedKind = stringLiterals[index + len + (ignoreCase * len)];
          jjmatchedPos  = curPos;
          startState    = stringLiterals[index + len + (ignoreCase * len) + 1];
#if DEBUG_TOKEN_MANAGER
          if (trace_enabled()) System.err.println(
                "  Currently matched the first: " + jjmatchedPos +
                " chars as token: <" + jjmatchedKind +
                " / " + tokenImage[jjmatchedKind] + "> (tm)");
#fi
          if (startState < 0 || !moveToNextChar()) {
            return curPos;
          }
          curPos++;
          break;
        } else {
          index += len + (ignoreCase * len) + 2;
          input_stream.backup(curPos + 1);
          curPos = 0;
          if (!moveToNextChar()) {
            assert false;
          }
        }
      } // end for
#if DEBUG_TOKEN_MANAGER
    } else {
      if (trace_enabled()) System.err.println(
            "  No string literal start with char: " + disp_char(curChar) + " (tm)");
#fi
    }
    return jjMoveNfa(startState, curPos);
  }
#fi

  protected ${STATIC?static :}boolean moveToNextChar() {
    try {
      curChar = input_stream.readChar();
#if IGNORE_CASE
      curChar = (int) Character.toLowerCase((char) curChar);
#fi
    } catch (java.io.IOException e) {
      return false;
    }
    return true;
  }

  private ${STATIC?static :}int[]  stateSet    = new int[${generatedStates}];
  private ${STATIC?static :}int[]  newStateSet = new int[${generatedStates}];
  private ${STATIC?static :}long[] moved       = new long[${generatedStates}];
  private ${STATIC?static :}long   moveIndex   = 1L;

  private static final long[][] jjChars = new long[${nfaSize}][];

  private static void initJjChars() {
    for (int i = 0; i < ${nfaSize}; i++) {
      jjChars[i] = new long[${charsVectorSize}];
      int ind = 0;
      // We originally generate something like RLE for the static arrays and
      // we actually expand them here.
      for (int j = 0; j < CharDataConsts.jjCharData[i].length; j += 2) {
        for (int k = 0; k < (int) CharDataConsts.jjCharData[i][j]; k++) {
          jjChars[i][ind++] = CharDataConsts.jjCharData[i][j + 1];
        }
      }
    }
  }

  private ${STATIC?static :}final int jjMoveNfa(final int startState, int curPos) {

    if (startState < 0) {
#if DEBUG_TOKEN_MANAGER
      if (trace_enabled()) System.err.println(
            "    No NFA start state, at pos: " + curPos + " (tm)");
#fi
      return curPos;
    }

    // We have a long array indexed by the NFA state number to roughly indicate
    // the input position so when the input reaches part Long.MAX_VALUE (which
    // should be extremely rare), we need to reset them all back to zero.
    if (++moveIndex == Long.MAX_VALUE) {
      for (int i = 0; i < ${generatedStates}; i++) {
        moved[i] = 0L;
      }
      moveIndex = 1L;
    }

    // We initialize the kind to MAX value so that when a match is found, we can
    // simply check if it's less than the current match and store it in that case.
    // This helps implement the 'first occurring' rule properly.
    int cnt = 0;
    stateSet[cnt++] = startState;
    moved[startState] = moveIndex;

    // Some NFA states have epsilon transitions (move on empty string).
    // So we just start with all of them. Note that the nextStates array already adds
    // the epsilon closure. Only the initial state needs to do this explicitly.
    {
      final int _csOff = jjcompositeState_offsets[startState];
      final int _csLen = jjcompositeState_lengths[startState];
      for (int _j = 0; _j < _csLen; _j++) {
        final int s = jjcompositeState_data[_csOff + _j];
        if (moved[s] != moveIndex) {
          stateSet[cnt++] = s;
          moved[s] = moveIndex;
        }
      }
    }

#if DEBUG_TOKEN_MANAGER
    if (trace_enabled()) System.err.println(
          "    Starting NFA with start state: " + disp_state(startState, lexStateNames) + " (tm)");
#fi
    do {
#if DEBUG_TOKEN_MANAGER
      if (trace_enabled()) System.err.println(
            "    Cur char: " + disp_char(curChar) + " (tm)");
#fi
      int newCnt = 0;
      int kind = Integer.MAX_VALUE;
      if (++moveIndex == Long.MAX_VALUE) {
        for (int i = 0; i < ${generatedStates}; i++) {
          moved[i] = 0L;
        }
        moveIndex = 1L;
      }

      int vectorIndex = curChar >> 6;
      long bitpattern = (1L << (curChar & 0x3f));
      do {
        int state = stateSet[--cnt];
#if DEBUG_TOKEN_MANAGER
        // TODO(sreeni) : Fix it to give better error message instead of UNKNOWN.
        if (trace_enabled()) System.err.println(
              "    Looking to move from state: " + disp_state(state, lexStateNames) +
              ", for token: <" +
              (jjmatchKinds[state] != Integer.MAX_VALUE
                    ? (jjmatchKinds[state] + " / " + tokenImage[jjmatchKinds[state]])
                    : "UNKNOWN") +
              "> (tm)");
#fi
        if ((jjChars[state][vectorIndex] & bitpattern) != 0L) {
          // Current input character can move this NFA state.
          // So add all the next states of the current states for use with the next input char.
          {
            final int _nsOff = jjnextStateSet_offsets[state];
            final int _nsLen = jjnextStateSet_lengths[state];
            for (int _k = 0; _k < _nsLen; _k++) {
              final int newState = jjnextStateSet_data[_nsOff + _k];
              if (moved[newState] != moveIndex) {
                // We add each state only once.
                newStateSet[newCnt++] = newState;
                moved[newState] = moveIndex;
              }
            }
          }
          int newKind = jjmatchKinds[state];
          if (kind > newKind) {
            // It's a state so store the matched kind if it's smaller than what's already matched.
            kind = newKind;
#if DEBUG_TOKEN_MANAGER
            if (trace_enabled()) System.err.println(
                  "    Found a match of kind: " + kind + " " + tokenImage[kind] +
                  " using the first: " + curPos + " characters" + " (tm)");
#fi
          }
        }
      } while (cnt > 0);

      if (kind != Integer.MAX_VALUE) {
        // We found a match. So remember the kind and position of the match.
        jjmatchedKind = kind;
        jjmatchedPos = curPos;
        // Reset the kind to max value so we can continue looking for a longer match.
        kind = Integer.MAX_VALUE;
      }

      // Swap the current and next state sets.
      int[] tmp = stateSet;
      stateSet = newStateSet;
      newStateSet = tmp;
      // Reset the number of states.
      cnt = newCnt;
      if (newCnt == 0) {
        // There were no transitions from any of the current states on the
        // current input. So we are done.
#if DEBUG_TOKEN_MANAGER
        if (trace_enabled()) System.err.println(
              "    Done with NFA, at pos: " + curPos + " (tm)");
#fi
        return curPos;
      }
      // Read the next character and try to continue running the NFA.
      if (!moveToNextChar()) {
        // EOF reached!
#if DEBUG_TOKEN_MANAGER
        if (trace_enabled()) System.err.println(
              "    Reached EOF (nfa), at pos: " + curPos + " (tm)");
#fi
        return curPos;
      }
      ++curPos;
    } while (cnt > 0);

    assert false :
        "Internal error. Please submit a bug at:https://github.com/javacc/javacc-8/issues";

    return curPos;
  }

  public static final boolean isToken(int kind) {
    return (jjtoToken[kind >> 6] & (1L << (kind & 0x3f))) != 0L;
  }

  public static final boolean isSkip(int kind) {
    return (jjtoSkip[kind >> 6] & (1L << (kind & 0x3f))) != 0L;
  }

  public static final boolean isSpecial(int kind) {
    return (jjtoSpecial[kind >> 6] & (1L << (kind & 0x3f))) != 0L;
  }

  public static final boolean isMore(int kind) {
    return (jjtoMore[kind >> 6] & (1L << (kind & 0x3f))) != 0L;
  }

  protected ${STATIC?static :}void reportError(int lastReadPosition) {
    int errorLine = input_stream.getEndLine();
    int errorColumn = input_stream.getEndColumn();
    String errorAfter = null;
    boolean eofSeen = false;
    try {
      input_stream.readChar();
      input_stream.backup(1);
    } catch (java.io.IOException e1) {
      eofSeen = true;
      errorAfter = lastReadPosition <= 1 ? "" : input_stream.GetImage();
      if (curChar == '\n' || curChar == '\r') {
         errorLine++;
         errorColumn = 0;
      } else {
         errorColumn++;
      }
    }
    if (!eofSeen) {
      input_stream.backup(1);
      errorAfter = lastReadPosition <= 1 ? "" : input_stream.GetImage();
    }
    throw new ${LEGACY_EXCEPTION_HANDLING?TokenMgrError:TokenMgrException}(eofSeen, curLexState, errorLine, errorColumn,
                            errorAfter, curChar, ${LEGACY_EXCEPTION_HANDLING?TokenMgrError:TokenMgrException}.LEXICAL_ERROR);
  }
#if DEBUG_TOKEN_MANAGER

  private ${STATIC?static :}boolean trace = true;

  public ${STATIC?static :}void enable_tracing() {
    trace = true;
  }

  public ${STATIC?static :}void disable_tracing() {
    trace = false;
  }

  public ${STATIC?static :}boolean trace_enabled() {
    return trace;
  }

  static String disp_state(final int state, final String[] lexStateNames) {
    return "<" + (state < lexStateNames.length ? lexStateNames[state] : ",") + ">-" + state;
  }

  static String disp_char(final int ic) {
    return "<" + String.valueOf(ic) + " / '" + add_escapes(ic) + "'>";
  }

  /**
   * Used to convert raw characters to their escaped version when these raw version
   *  cannot be used as part of an ASCII string literal.
   */
  static String add_escapes(String str) {
    final StringBuilder retval = new StringBuilder();
    char ch;
    for (int i = 0; i < str.length(); i++) {
      switch (str.charAt(i)) {
        case '\b':
          retval.append("\\b");
          continue;
        case '\t':
          retval.append("\\t");
          continue;
        case '\n':
          retval.append("\\n");
          continue;
        case '\f':
          retval.append("\\f");
          continue;
        case '\r':
          retval.append("\\r");
          continue;
        case '\"':
          retval.append("\\\"");
          continue;
        case '\'':
          retval.append("\\\'");
          continue;
        case '\\':
          retval.append("\\\\");
          continue;
        default:
          if ((ch = str.charAt(i)) < 0x20 || ch > 0x7e) {
            String s = "0000" + Integer.toString(ch, 16);
            retval.append("\\u" + s.substring(s.length() - 4, s.length()));
          } else {
            retval.append(ch);
          }
      }
    }
    return retval.toString();
  }

  /**
   * Used to convert raw characters to their escaped version when these raw version
   *  cannot be used as part of an ASCII string literal.
   */
  static String add_escapes(final int ch) {
    switch (ch) {
      case 8:         // '\b'
        return "\\b";
      case 9:         // '\t'
        return "\\t";
      case 10:        // '\n'
        return "\\n";
      case 12:        // '\f'
        return "\\f";
      case 13:        // '\r'
        return "\\r";
      case 34:        // '\"'
        return "\\\"";
      case 39:        // '\''
        return "\\\'";
      case 92:        // '\\':
        return "\\\\";
      default:
        if (ch < 0x20 || ch > 0x7e) {
          final String s = "0000" + Integer.toString(ch, 16);
          return "\\u" + s.substring(s.length() - 4, s.length());
        } else {
          return String.valueOf((char) ch);
        }
    }
  }
